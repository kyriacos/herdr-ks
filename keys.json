{
  "layout:ks": {
    "cmd-w": "ks-tabs.close",
    "cmd-shift-w": "ks-tabs.close-pane",
    "cmd-shift-e": "ks-tabs.panel:files",
    "cmd-shift-g": "ks-tabs.panel:changes",
    "cmd-shift-n": "mod.open:ks-worktree",
    "cmd-shift-u": "ks-tabs.panel:prs",
    "cmd-shift-m": {
      "command": "layout.toggle",
      "args": {
        "id": "my-prs"
      }
    },
    "cmd-shift-t": "ks-tabs.undo",
    "cmd-shift-z": "ks-zen.toggle",
    "cmd-shift-f": "ks-zen.focus",
    "cmd-shift-,": "mod.open:ks-settings",
    "cmd-shift-enter": "ks-zen.zoomtab",
    "cmd-shift-j": "ks-tabs.panel:notes",
    "cmd-alt-shift-enter": "ks-zen.zoom"
  }
}
