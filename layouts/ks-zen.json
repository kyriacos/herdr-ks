{
  "id": "zen-root",
  "type": "row",
  "version": "0.10.0",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "terminal_menu": "ks-pane",
  "ui_font": "JetBrains Mono",
  "terminal_padding": [
    14,
    12
  ],
  "background": {
    "gradient": [
      "#020306",
      "#0b0d14"
    ],
    "angle": 165
  },
  "resizable": false,
  "children": [
    {
      "id": "zen-left",
      "type": "column",
      "size": {
        "weight": 10
      },
      "children": [],
      "window_drag": true
    },
    {
      "id": "zen-center",
      "type": "column",
      "size": {
        "weight": 80
      },
      "resizable": false,
      "children": [
        {
          "id": "zen-top",
          "type": "column",
          "size": {
            "weight": 3
          },
          "children": [],
          "window_drag": true
        },
        {
          "id": "zen-bar",
          "type": "block",
          "size": {
            "px": 34
          },
          "content": {
            "mod": "ks-zen"
          },
          "window_drag": true
        },
        {
          "id": "zen-main",
          "type": "block",
          "size": {
            "weight": 94
          },
          "radius": 14,
          "shadow": "lg",
          "border": {
            "width": 1,
            "color": "#ffffff22"
          },
          "content": {
            "tab": "active",
            "pane": {
              "gap": 8,
              "radius": 10,
              "background": "background",
              "lone": true,
              "border": {
                "width": 1,
                "color": "border"
              },
              "focus": {
                "width": 1,
                "color": "accent"
              },
              "header": {
                "content": {
                  "mod": "ks-pane"
                },
                "height": 30,
                "position": "top",
                "reveal": "always"
              }
            }
          }
        },
        {
          "id": "zen-bottom",
          "type": "column",
          "size": {
            "weight": 3
          },
          "children": [],
          "window_drag": true
        }
      ]
    },
    {
      "id": "zen-right",
      "type": "column",
      "size": {
        "weight": 10
      },
      "children": [],
      "window_drag": true
    }
  ],
  "floating": [
    {
      "id": "ks-keys",
      "content": {
        "mod": "ks-keys"
      },
      "edge": "bottom",
      "align": "center"
    }
  ]
}
