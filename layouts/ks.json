{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.14"
  },
  "version": "0.1.0",
  "terminal_menu": "ks-pane",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "preview": "layouts/ks.png",
  "terminal_opacity": 0,
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "ks-workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "dashboard",
              "type": "block",
              "size": {
                "px": 56
              },
              "min": 30,
              "content": {
                "mod": "ks-dashboard"
              }
            },
            {
              "id": "now-tasks",
              "type": "block",
              "size": {
                "px": 60
              },
              "min": 30,
              "content": {
                "mod": "ks-nowtasks"
              }
            },
            {
              "id": "my-prs",
              "type": "block",
              "size": {
                "px": 250
              },
              "min": 30,
              "content": {
                "mod": "ks-myprs"
              }
            },
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "ks-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "ks-agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "ks-workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "ks-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "ks-pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "ks-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "ks-changes"
                      }
                    },
                    {
                      "id": "prs",
                      "type": "block",
                      "content": {
                        "mod": "ks-prs"
                      }
                    },
                    {
                      "id": "notes",
                      "type": "block",
                      "content": {
                        "mod": "ks-notes"
                      }
                    },
                    {
                      "id": "tasks",
                      "type": "block",
                      "content": {
                        "mod": "ks-tasks"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "ks-status"
          }
        }
      ]
    }
  ],
  "floating": [
    {
      "id": "ks-keys",
      "content": {
        "mod": "ks-keys"
      },
      "edge": "bottom",
      "align": "center"
    },
    {
      "id": "ks-zen",
      "content": {
        "mod": "ks-zen"
      },
      "edge": "top",
      "align": "end"
    }
  ]
}
